{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qh.example/schemas/voice-kit/device-config-v2.json",
  "title": "QH Voice Kit device configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "network",
    "stt",
    "reply",
    "tts",
    "assistant",
    "qhSync",
    "preferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssid", "password"],
      "properties": {
        "ssid": {"type": "string", "minLength": 1, "maxLength": 32},
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "writeOnly": true,
          "x-qh-secret": true
        }
      }
    },
    "stt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "endpoint",
        "apiKey",
        "resourceId"
      ],
      "properties": {
        "adapter": {"const": "doubao-asr-v1"},
        "endpoint": {"type": "string", "pattern": "^wss://"},
        "apiKey": {
          "type": "string",
          "minLength": 1,
          "writeOnly": true,
          "x-qh-secret": true
        },
        "resourceId": {"type": "string", "minLength": 1}
      }
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "endpoint", "model", "credential"],
      "properties": {
        "adapter": {"const": "openai-compatible-v1"},
        "endpoint": {"type": "string", "pattern": "^https://"},
        "model": {"type": "string", "minLength": 1},
        "credential": {
          "type": "string",
          "minLength": 1,
          "writeOnly": true,
          "x-qh-secret": true
        }
      }
    },
    "tts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "endpoint",
        "credential",
        "resourceId",
        "speaker"
      ],
      "properties": {
        "adapter": {"const": "doubao-tts-v1"},
        "endpoint": {"type": "string", "pattern": "^https://"},
        "credential": {
          "type": "string",
          "minLength": 1,
          "writeOnly": true,
          "x-qh-secret": true
        },
        "resourceId": {"type": "string", "minLength": 1},
        "speaker": {"type": "string", "minLength": 1}
      }
    },
    "assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "systemPrompt", "maxReplyChars"],
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "systemPrompt": {"type": "string", "maxLength": 2000},
        "maxReplyChars": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "qhSync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "endpoint", "deviceId", "credential"],
      "properties": {
        "enabled": {"type": "boolean"},
        "endpoint": {"type": "string"},
        "deviceId": {"type": "string"},
        "credential": {
          "type": "string",
          "writeOnly": true,
          "x-qh-secret": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {
            "properties": {
              "endpoint": {"pattern": "^https://"},
              "deviceId": {"minLength": 1},
              "credential": {"minLength": 1}
            }
          }
        }
      ]
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volumePercent"],
      "properties": {
        "volumePercent": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    }
  }
}
