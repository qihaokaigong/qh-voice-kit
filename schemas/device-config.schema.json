{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qh.example/schemas/voice-kit/device-config-v3.json",
  "title": "QH Voice Kit device configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "network",
    "realtimeVoice",
    "assistant",
    "qhSync",
    "preferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssid", "password"],
      "properties": {
        "ssid": {"type": "string", "minLength": 1, "maxLength": 32},
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "writeOnly": true,
          "x-qh-secret": true
        }
      }
    },
    "realtimeVoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "apiKey", "voice"],
      "properties": {
        "adapter": {"const": "doubao-seeduplex-v1"},
        "apiKey": {
          "type": "string",
          "minLength": 1,
          "writeOnly": true,
          "x-qh-secret": true
        },
        "voice": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "systemPrompt", "showReplyText"],
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "systemPrompt": {"type": "string", "maxLength": 2000},
        "showReplyText": {"type": "boolean"}
      }
    },
    "qhSync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "endpoint", "deviceId", "credential"],
      "properties": {
        "enabled": {"type": "boolean"},
        "endpoint": {"type": "string"},
        "deviceId": {"type": "string"},
        "credential": {
          "type": "string",
          "writeOnly": true,
          "x-qh-secret": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {
            "properties": {
              "endpoint": {"pattern": "^https://"},
              "deviceId": {"minLength": 1},
              "credential": {"minLength": 1}
            }
          }
        }
      ]
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volumePercent"],
      "properties": {
        "volumePercent": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    }
  }
}
